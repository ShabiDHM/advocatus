.about-us-list ul li i {color: #0fa4ef;}
.color-bold {color: #0fa4ef}
.stats-desc.onepage .stats-icon {color: #0fa4ef}
.serv-marg i {color: #0fa4ef}
.serv-icon i { color: #0fa4ef}
.blog-name a:hover {color: #0fa4ef}
.blog-desc li i{color:#0fa4ef}
.progress-bar {background-color: #0fa4ef}
.tag_line_author a{color: #0fa4ef}
.breadcrumbs a {color:#0fa4ef;}
.woocommerce-breadcrumb a {color:#0fa4ef}
.soc-about li a:hover { color: #0fa4ef}
.insomnia_pg a:hover { color: #0fa4ef; border-color: #0fa4ef; }
.insomnia_pg span { color: #0fa4ef !important; border-color: #0fa4ef; }
.insomnia_pg_single span { border: 1px solid #0fa4ef;}
.insomnia_pg_single a:hover > span { border: 1px solid #0fa4ef}
.soc-footer li a:hover {color: #0fa4ef}
.post-set:hover ul.icon-links li a:hover,.post-set:hover ul.icon-links li a:focus {color: #0fa4ef}
.blog-main:hover ul.icon-links li a:hover,.blog-main:hover ul.icon-links li a:focus {color: #0fa4ef}
.new-services .new-services-icon span{color:#0fa4ef;}
.new-services .new-services-icon:after {background: #0fa4ef}
.contact-icon {background: #0fa4ef;}
.pricing_tables_name {color:#0fa4ef;}
.pricing_tables_buttons a {background: #0fa4ef}
.burger_insomnia_menu_overlay_normal .burger_insomnia_main_menu a:hover {color: #0fa4ef}
