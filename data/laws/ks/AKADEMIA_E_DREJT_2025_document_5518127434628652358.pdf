                language: "sq",
                nav_icon: {
                    prev: '<i class="fa fa-chevron-circle-left"></i>',
                    next: '<i class="fa fa-chevron-circle-right"></i>'
                },
                show_previous: 12,
                show_next: 1,
                action: function() {
                    return myDateFunction(this.id, false);
                },
                data: eventData
            });

            jQuery(".calCnt").addClass('ajax-loader');
            datas = Object();
            datas.action = "getKJCSchedules";
            datas.params = {
                "dId": "testID",
                "dDt": "2026-07-24",
                "lng": "sq"
            };
            datasType = "jsonp";
            jQuery.ajax({
                url: "/getIncPHP.php",
                data: datas,
                success: function(result) {
                    jQuery(".calCnt").html(result);
                    jQuery(".calCnt").removeClass('ajax-loader');
                }
            });
        });

        function myDateFunction(id, fromModal) {
            jQuery(".calendar-dow td").removeClass("active");
            jQuery("#" + id).addClass("active");
            jQuery(".calCnt").html("");
            jQuery(".calCnt").addClass('ajax-loader');
            datas = Object();
            datas.action = "getKJCSchedules";
            datas.params = {
                "dId": id,
                "dDt": jQuery("#" + id).data("date"),
                "lng": "sq"
            };
            datasType = "jsonp";
            jQuery.ajax({
                url: "/getIncPHP.php",
                data: datas,
                success: function(result) {
                    jQuery(".calCnt").html(result);
                    jQuery(".calCnt").removeClass('ajax-loader');
                }
            });
        }
