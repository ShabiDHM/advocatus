.travel-deals-list ul li i{color:#0fa4ef}
.food-deals-list {color:#0fa4ef;}
.food-deals-list i{color:#0fa4ef;}
.bbp-forum-info a {color: #0fa4ef;}
.bbp-topic-title > a {color:#0fa4ef;}
.product-category  > a:hover h3 {background: #0fa4ef;}
