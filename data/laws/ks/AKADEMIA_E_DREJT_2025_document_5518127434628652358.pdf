.insomnia_image_wrapper {background: #0fa4ef}
.tweet_list li:before {color: #0fa4ef;}
.tweet_text a { color: #0fa4ef}
.rsBlock-meta li i {color: #0fa4ef}
.gallery-slider .owl-nav [class*='owl-']:hover {background: #0fa4ef;}
ul.social-links li a:hover {color: #0fa4ef}
.center-line {background: #0fa4ef}
.hi-icon.ver-industrial {background: #0fa4ef;}
.hi-icon-effect .hi-icon.ver-industrial:hover {background: #0fa4ef;}
.hi-icon-effect .hi-icon {color: #0fa4ef}
.hi-icon-effect .hi-icon:hover {color: #0fa4ef}
.insomnia_icon_box .multi-serv-icon { background: #0fa4ef}
